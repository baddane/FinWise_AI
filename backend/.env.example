# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Local Docker:  postgresql://finwise:password@db:5432/finwise_db
# Railway:       provided automatically via the Postgres plugin (DATABASE_URL)
# Vercel:        use Vercel Postgres (Neon) URL — copy from your project dashboard
#                or use an external provider (Neon, Supabase, Aiven…)
DATABASE_URL=postgresql://finwise:password@localhost:5432/finwise_db

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ────────────────────────────────────────────────────────────────────
# Must be a valid JSON array of allowed origins.
# Local:    ["http://localhost:3000"]
# Railway:  ["https://your-frontend.up.railway.app"]
# Vercel:   ["https://your-frontend.vercel.app"]
CORS_ORIGINS=["http://localhost:3000"]

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
# Option A — Gmail App Password (recommended for dev):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=FinWise AI <your@gmail.com>

# Option B — Resend SMTP (recommended for prod, free tier 3k/month):
#   https://resend.com → SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=re_xxxxxxxxxxxx
# SMTP_FROM=FinWise AI <no-reply@yourdomain.com>

# ── Frontend URL ─────────────────────────────────────────────────────────────
# Used to build the email verification link
FRONTEND_URL=http://localhost:3000
