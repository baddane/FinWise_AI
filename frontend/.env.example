# ── Backend API URL ─────────────────────────────────────────────────────────
# Local:    http://localhost:8000
# Railway:  https://your-backend.up.railway.app  (set BEFORE building the image)
#
# IMPORTANT: This variable is embedded into the JavaScript bundle AT BUILD TIME.
# On Railway, set it as an environment variable in the frontend service so it
# is passed as a Docker build argument automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000
