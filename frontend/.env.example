# ── Backend API URL ─────────────────────────────────────────────────────────
# Local:    http://localhost:8000
# Railway:  https://your-backend.up.railway.app
# Vercel:   https://your-backend-api.vercel.app
#
# IMPORTANT: This variable is embedded into the JavaScript bundle AT BUILD TIME.
# On Railway → set it as an environment variable in the frontend service.
# On Vercel  → set it in Project Settings → Environment Variables.
#              Vercel passes NEXT_PUBLIC_* variables to the build automatically.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Same Client ID as backend (GOOGLE_CLIENT_ID)
# Leave empty to hide the Google button
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
